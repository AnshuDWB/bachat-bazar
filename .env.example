# ==============================================================================
# BACHAT BAZAR - META WHATSAPP CLOUD API & PRODUCTION CONFIGURATION
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://www.bachatbazar.space

# 2. Meta WhatsApp Business Cloud API Credentials
# Get these from Meta for Developers (https://developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token_here
WHATSAPP_API_VERSION=v21.0

# 3. Meta Webhook Security Verification Token
# Set any secret phrase you want and enter the same in Meta Webhook configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=bachat_bazar_secure_webhook_token_2026

# 4. Store Official Numbers
STORE_PHONE=7073222340
ADMIN_PHONE_1=7073222340
ADMIN_PHONE_2=9664185654
